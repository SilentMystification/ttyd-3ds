; gpuprobe shader: colour chosen by bool uniform b14 (true: vertex colour, false: green)
; SPDX-License-Identifier: MIT
; Copyright (c) the ctr-devkit authors

.fvec projection[4]

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)
.constf green(0.0, 1.0, 0.0, 1.0)
.alias ONE consts.xxxx
.alias INV255 consts.yyyy
.bool u0,u1,u2,u3,u4,u5,u6,u7,u8,u9,u10,u11,u12,u13,u14

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc v2

.entry main_b14
.proc main_b14
    mov r0.xyz, inpos
    mov r0.w, ONE
    dp4 r1.x, projection[0], r0
    dp4 r1.y, projection[1], r0
    dp4 r1.z, projection[2], r0
    dp4 r1.w, projection[3], r0
    mov outpos, r1
    mul r2, INV255, inclr
    mov r3, intc
    mov outtc0, r3
    ifu u14
        mov outclr, r2
    .else
        mov outclr, green
    .end
    end
.end
