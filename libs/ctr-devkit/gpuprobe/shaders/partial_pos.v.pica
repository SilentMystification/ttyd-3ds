.fvec projection[4]

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)
.constf green(0.0, 1.0, 0.0, 1.0)
.alias ONE consts.xxxx
.alias INV255 consts.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc v2

.entry main_ppos
.proc main_ppos
    mov r0.xyz, inpos
    mov r0.w, ONE
    dp4 r1.x, projection[0], r0
    dp4 r1.y, projection[1], r0
    dp4 r1.z, projection[2], r0
    dp4 r1.w, projection[3], r0
    mov outpos.xyz, r1
    mul r2, INV255, inclr
    mov outclr, r2
    mov r3, intc
    mov outtc0, r3
    end
.end
