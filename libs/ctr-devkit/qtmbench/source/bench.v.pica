; qtmbench vertex shader: position through a projection, color (0..255
; ubyte or float) scaled to 0..1, texcoord passed through. Each output is
; written once, in full (the PICA200 hangs on partial output writes).
;
; SPDX-License-Identifier: MIT

.fvec projection[4]

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)
.alias ONE consts.xxxx
.alias INV255 consts.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc v2

.proc main
    mov r0.xyz, inpos
    mov r0.w, ONE
    dp4 r1.x, projection[0], r0
    dp4 r1.y, projection[1], r0
    dp4 r1.z, projection[2], r0
    dp4 r1.w, projection[3], r0
    mov outpos, r1
    mul r2, INV255, inclr
    mov outclr, r2
    mov r3, intc
    mov outtc0, r3
    end
.end
